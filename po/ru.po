#: be-station:44
msgid "Create a new boot environment"
msgstr "Создание нового загрузочного окружения"

#: be-station:45
msgid "Source boot environment: {be}"
msgstr "Исходное загрузочное окружение: {be}"

#: be-station:46
msgid "Please enter a name for the boot environment."
msgstr "Введите имя для загрузочного окружения."

#: be-station:58
msgid "Rename a boot environment"
msgstr "Переименование загрузочного окружения"

#: be-station:59
msgid "Please enter a new name for the boot environment."
msgstr "Введите новое имя для загрузочного окружения."

#: be-station:77
msgid "Delete a boot environment"
msgstr "Удаление загрузочного окружения"

#: be-station:78
msgid "Are you sure? This action cannot be undone."
msgstr "Вы уверены? Это действие не может быть отмененно."

#: be-station:87 be-station:108 be-station:196 be-station:226
msgid "BE Station"
msgstr "Центр загрузочных окружений"

#: be-station:88
msgid "You cannot delete an active boot environment"
msgstr "Вы не можите удалить активное загрузочное окружение"

#: be-station:119
msgid "BE name"
msgstr "Имя BE"

#: be-station:122
msgid "Active"
msgstr "Активно"

#: be-station:125
msgid "Mountpoint"
msgstr "Точка монтрования"

#: be-station:128
msgid "Space"
msgstr "Размер"

#: be-station:131
msgid "Date"
msgstr "Дата создания"

#: be-station:134
msgid "Time"
msgstr "Время создания"

#: be-station:138
msgid "Create BE"
msgstr "Создать BE"

#: be-station:141
msgid "Rename BE"
msgstr "Переименовать BE"

#: be-station:144
msgid "Activate BE"
msgstr "Активировать BE"

#: be-station:147
msgid "Delete BE"
msgstr "Удалить BE"

#: be-station:150
msgid "Mount BE"
msgstr "Примонтировать BE"

#: be-station:153
msgid "Unmount BE"
msgstr "Отмонтировать BE"

#: be-station:213
msgid "Entered wrong password"
msgstr "Введен неверный пароль"

#: be-station:214
msgid "Would you like to try again?"
msgstr "Вы хотите попробывать снова?"

#: be-station:233
msgid "Confirm password for"
msgstr "Подтвердите пароль для"

#: be-station:265
msgid "BE Station must be run with root privileges"
msgstr "Центр загрузочных окружений должен быть запущен с правами root"

#: be-station:266
msgid "Would you like to use sudo?"
msgstr "Вы желаете использовать sudo?"
