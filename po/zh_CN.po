#: be-station:44
msgid "Create a new boot environment"
msgstr "创建新的启动环境"

#: be-station:45
msgid "Source boot environment: {be}"
msgstr "源启动环境：{be}"

#: be-station:46
msgid "Please enter a name for the boot environment."
msgstr "请为这个新的启动环境起个名字。"

#: be-station:58
msgid "Rename a boot environment"
msgstr "重命名启动环境"

#: be-station:59
msgid "Please enter a new name for the boot environment."
msgstr "请为启动环境输入新的名字。"

#: be-station:77
msgid "Delete a boot environment"
msgstr "删除启动环境"

#: be-station:78
msgid "Are you sure? This action cannot be undone."
msgstr "你确定吗？该操作不可撤销。"

#: be-station:87 be-station:108 be-station:196 be-station:226
msgid "BE Station"
msgstr "启动环境中心"

#: be-station:88
msgid "You cannot delete an active boot environment"
msgstr "你无法删除当前正在运行的启动环境"

#: be-station:119
msgid "BE name"
msgstr "启动环境名称"

#: be-station:122
msgid "Active"
msgstr "激活"

#: be-station:125
msgid "Mountpoint"
msgstr "挂载点"

#: be-station:128
msgid "Space"
msgstr "空间"

#: be-station:131
msgid "Date"
msgstr "日期"

#: be-station:134
msgid "Time"
msgstr "时间"

#: be-station:138
msgid "Create BE"
msgstr "创建启动环境"

#: be-station:141
msgid "Rename BE"
msgstr "删除启动环境"

