msgid "Mount BE"
msgstr "挂载启动环境"

#: be-station:153
msgid "Unmount BE"
msgstr "卸载启动环境"

#: be-station:213
msgid "Entered wrong password"
msgstr "输入的密码错误"

#: be-station:214
msgid "Would you like to try again?"
msgstr "你想重试一次吗？"

